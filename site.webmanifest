---
layout: null
permalink: /site.webmanifest
---
{
  "name": {{ site.title | jsonify }},
  "short_name": "ElArk",
  "description": {{ site.description | strip_newlines | strip | jsonify }},
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#faf9f7",
  "theme_color": "#2563eb",
  "lang": "en",
  "icons": [
    {
      "src": "{{ '/assets/img/favicons/android-chrome-192x192.png' | relative_url }}",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "{{ '/assets/img/favicons/android-chrome-512x512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "{{ '/assets/img/favicons/android-chrome-512x512.png' | relative_url }}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
